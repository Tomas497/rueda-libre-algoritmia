Algoritmo cobro
	Definir nombre Como Caracter
	definir horas, pxh Como Entero
	Escribir "Ingrese su nombre: "
	leer nombre
	Escribir "¿Cuantas fueron tus horas de recorrido?: "
	leer horas
	pxh = (horas * 10000)
	Escribir "Hola, " nombre " tu alquiler de " horas " horas, cuesta: " pxh ". Que tengas un gran dia!"

	
FinAlgoritmo
